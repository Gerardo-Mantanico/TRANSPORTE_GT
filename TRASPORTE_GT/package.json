{
  "name": "transporte-gt",
  "private": true,
  "version": "0.0.0",
  "description": "Plataforma de transporte que conecta pasajeros, equipos y decisiones. Frontend en React + TypeScript.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:movil": "vite --mode movil",
