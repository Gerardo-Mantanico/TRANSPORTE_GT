# npm run dev:movil: rutas relativas, el servidor de Vite (https) las reenvía al gateway (GATEWAY_URL)
GATEWAY_URL=http://localhost:8080
VITE_API_URL=/v1/identity
VITE_CUSTOMERS_API_URL=/v1/customers
VITE_TICKETS_API_URL=/v1/tickets
VITE_TRIPS_API_URL=/v1/trips
VITE_FLEET_API_URL=/v1/fleet
VITE_RENTALS_API_URL=/v1/rentals
VITE_COSTS_API_URL=/v1/costs
VITE_REPORTS_API_URL=/v1/reports
